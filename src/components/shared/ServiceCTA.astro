---
import Button from './Button.astro';

interface Props {
  title: string;
  description?: string;
  primaryButtonLabel?: string;
  primaryButtonHref?: string;
  secondaryButtonLabel?: string;
  secondaryButtonHref?: string;
  colorScheme: 'blue' | 'purple' | 'yellow';
}

const { 
  title, 
  description,
  primaryButtonLabel = "Agendar una llamada",
  primaryButtonHref = "/contact",
  secondaryButtonLabel = "Ver proyectos",
  secondaryButtonHref = "/works",
  colorScheme 
} = Astro.props;

const overlays: Record<string, string> = {
  blue: 'linear-gradient(to right, rgba(37,99,235,0.88) 0%, rgba(29,78,216,0.85) 50%, rgba(30,64,175,0.90) 100%)',
  purple: 'linear-gradient(to right, rgba(147,51,234,0.88) 0%, rgba(126,34,206,0.85) 50%, rgba(107,33,168,0.90) 100%)',
  yellow: 'linear-gradient(to right, rgba(202,138,4,0.88) 0%, rgba(161,98,7,0.85) 50%, rgba(133,77,14,0.90) 100%)',
};

const backgrounds: Record<string, string> = {
  blue: '/assets/images/cta/web.jpg',
  purple: '/assets/images/cta/branding.jpg',
  yellow: '/assets/images/cta/home.jpg',
};

const overlayStyle = overlays[colorScheme];
const backgroundImage = backgrounds[colorScheme];
---

<section class="relative overflow-hidden py-16 md:py-24 bg-gray-950">
  <div class="absolute inset-0 z-0">
    <img
      src={backgroundImage}
      alt=""
      class="absolute inset-0 h-full w-full object-cover"
      loading="lazy"
      decoding="async"
    />
    <div
      class="absolute inset-0 z-[1]"
      style={`background-image: ${overlayStyle};`}
      aria-hidden="true"
    ></div>
  </div>

  <div class="relative z-10 max-w-4xl mx-auto px-4 text-center" data-aos="fade-up" data-aos-delay="100">
    <h2 class="text-2xl md:text-4xl font-main text-white my-2 mb-4">
      {title}
    </h2>
    {description && (
      <p class="text-base md:text-lg text-white/80 mb-10 max-w-3xl mx-auto">
        {description}
      </p>
    )}
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
      <Button href={primaryButtonHref} label={primaryButtonLabel} variant="secondary" {colorScheme} />
      <Button href={secondaryButtonHref} label={secondaryButtonLabel} variant="tertiary" {colorScheme} />
    </div>
  </div>
</section>
