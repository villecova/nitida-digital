---
import Button from "./shared/Button.astro";

interface Props {
  colorScheme?: 'blue' | 'purple' | 'yellow' | null;
}

const { colorScheme = null } = Astro.props;

const overlays: Record<string, string> = {
  home: 'linear-gradient(to right, rgba(17,24,39,0.88) 0%, rgba(0,0,0,0.82) 50%, rgba(31,41,55,0.88) 100%)',
  blue: 'linear-gradient(to right, rgba(37,99,235,0.88) 0%, rgba(29,78,216,0.85) 50%, rgba(30,64,175,0.90) 100%)',
  purple: 'linear-gradient(to right, rgba(147,51,234,0.88) 0%, rgba(126,34,206,0.85) 50%, rgba(107,33,168,0.90) 100%)',
  yellow: 'linear-gradient(to right, rgba(202,138,4,0.88) 0%, rgba(161,98,7,0.85) 50%, rgba(133,77,14,0.90) 100%)',
};

const backgrounds: Record<string, string> = {
  home: '/assets/images/cta/home.jpg',
  blue: '/assets/images/cta/web.jpg',
  purple: '/assets/images/cta/branding.jpg',
};

const schemeKey = colorScheme && colorScheme in overlays ? colorScheme : 'home';
const overlayStyle = overlays[schemeKey];
const backgroundImage = backgrounds[schemeKey] ?? backgrounds.home;
---

<section class="relative overflow-hidden py-16 md:py-24 bg-gray-950">
  <div class="absolute inset-0 z-0">
    <img
      src={backgroundImage}
      alt=""
      class="absolute inset-0 h-full w-full object-cover"
      loading="lazy"
      decoding="async"
    />
    <div
      class="absolute inset-0 z-[1]"
      style={`background-image: ${overlayStyle};`}
      aria-hidden="true"
    ></div>
  </div>

  <div class="relative z-10 max-w-4xl mx-auto px-4 text-center" data-aos="fade-up" data-aos-delay="100">
    <h2 class="text-3xl md:text-5xl font-main text-white my-2 mb-6">
      ¿Listo para dar el siguiente paso?
    </h2>
    <p class="text-lg text-white mb-8 max-w-2xl mx-auto">
      Comparte los detalles de tu proyecto y te oriento sobre el siguiente paso.
    </p>
    <Button href="/contact#formulario" label="Solicitar información" variant="secondary" {colorScheme} />
  </div>
</section>
