---
import { site } from '../../data/site';

interface Props {
  title?: string;
}

const { title = 'Quién está detrás de Nítida' } = Astro.props;
---

<section class="py-16 md:py-24 bg-white" id="sobre-mi">
  <div class="max-w-3xl mx-auto px-4 text-center" data-aos="fade-up" data-aos-delay="100">
    <h2 class="text-3xl md:text-5xl font-main text-gray-900 my-2 mb-6">{title}</h2>
    <p class="text-lg text-gray-700 leading-relaxed mb-4">
      Nítida está liderada por <strong>{site.personName}</strong>, diseñador con más de 10 años
      de experiencia creando identidades visuales y sitios web para negocios y profesionales.
    </p>
    <p class="text-base text-accent leading-relaxed mb-4">
      Combino diseño visual y desarrollo web para entregar piezas claras, profesionales y listas
      para usarse. Trabajo de forma remota desde México, con atención directa durante todo el proyecto.
    </p>
    <p class="text-sm text-gray-500">
      Sin intermediarios innecesarios: hablas con quien diseña e implementa.
    </p>
  </div>
</section>
