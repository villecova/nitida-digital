---
import { serviceLabel } from '../../lib/projects';

interface ProjectCard {
  slug: string;
  title: string;
  description: string;
  image: string;
  serviceCategories: ('web' | 'branding' | 'digital')[];
  scope: string;
  role?: string;
  url?: string;
}

interface Props {
  projects: ProjectCard[];
  title?: string;
  subtitle?: string;
}

const {
  projects,
  title = 'Proyectos destacados',
  subtitle = 'Casos recientes de sitios web e identidad visual.',
} = Astro.props;
---

<section class="py-16 md:py-24 bg-white" id="proyectos-destacados">
  <div class="max-w-3xl mx-auto px-4">
    <div class="text-center mb-10" data-aos="fade-up" data-aos-delay="100">
      <h2 class="text-3xl md:text-4xl font-main text-gray-900 my-2">{title}</h2>
      <p class="text-base text-accent max-w-xl mx-auto">{subtitle}</p>
    </div>

    <ul class="border-gray-200">
      {projects.map((project, index) => (
        <li
          class="border-b border-gray-200 last:border-b-0 first:border-t"
          data-aos="fade-up"
          data-aos-delay={120 + index * 40}
        >
          <div class="flex gap-4 sm:gap-5 items-start py-5">
            <div class="w-16 h-16 sm:w-20 sm:h-20 flex-shrink-0 rounded-xl overflow-hidden bg-slate-50 border border-gray-100 p-1.5">
              <img
                src={project.image}
                alt=""
                class="w-full h-full object-contain"
                loading="lazy"
                aria-hidden="true"
              />
            </div>
            <div class="min-w-0 flex-1">
              <p class="text-[11px] font-medium uppercase tracking-wider text-accent mb-1">
                {serviceLabel(project.serviceCategories, project.scope)}
                {project.role ? ` · ${project.role}` : ''}
              </p>
              <h3 class="text-lg font-semibold text-gray-900 leading-snug">
                <a
                  href={`/works/${project.slug}`}
                  class="hover:text-gray-600 transition-colors"
                  data-track="project_click"
                  data-project={project.slug}
                >
                  {project.title}
                </a>
              </h3>
              <p class="text-sm text-gray-500 mt-1.5 leading-relaxed line-clamp-2">
                {project.description}
              </p>
              <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
                <a
                  href={`/works/${project.slug}`}
                  class="font-medium text-gray-900 hover:underline underline-offset-2"
                  data-track="project_click"
                  data-project={project.slug}
                >
                  Ver caso
                </a>
                {project.url && (
                  <a
                    href={project.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-accent hover:text-gray-900"
                  >
                    Sitio publicado
                  </a>
                )}
              </div>
            </div>
          </div>
        </li>
      ))}
    </ul>

    <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center text-center" data-aos="fade-up">
      <a href="/web-design#portafolio" class="text-sm font-medium text-blue-600 hover:opacity-70">
        Más sitios web →
      </a>
      <a href="/branding#portafolio" class="text-sm font-medium text-purple-600 hover:opacity-70">
        Más identidad visual →
      </a>
    </div>
  </div>
</section>
