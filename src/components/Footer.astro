---
import { site } from '../data/site';

const { hideTerms = false, hideSocial = false } = Astro.props;

const links = [
  { label: 'Inicio', href: '/' },
  { label: 'Sitios web', href: '/web-design' },
  { label: 'Identidad visual', href: '/branding' },
  // { label: 'Planes', href: '/planes' },
  { label: 'Contacto', href: '/contact' },
  { label: 'Apps', href: '/digital-products' },
  ...(hideTerms ? [] : [{ label: 'Términos y condiciones', href: '/terms-and-conditions' }]),
];

---

<footer class="bg-gradient-to-r from-gray-900 via-black to-gray-800 text-white border-t border-gray-800">
  <div class="max-w-screen-lg mx-auto">
    <nav class="border-b border-gray-700 mb-12" aria-label="Pie de página">
      <div class="max-w-screen-xl mx-auto px-4 py-6 flex flex-col md:flex-row justify-between items-center gap-6 text-sm">
        <div class="flex flex-wrap gap-x-6 gap-y-3 items-center justify-center md:justify-start">
          {links.map((link) => (
            <a href={link.href} class="hover:text-gray-300 transition-colors">
              {link.label}
            </a>
          ))}
        </div>
        {!hideSocial && (
          <div class="flex gap-4 items-center justify-center">
            <a
              href={site.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-gray-300 transition-colors"
              aria-label="Instagram"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
              </svg>
            </a>
            <a
              href={site.mailto}
              class="hover:text-gray-300 transition-colors"
              data-track="email_click"
              aria-label="Correo"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </a>
          </div>
        )}
      </div>
    </nav>

    <div class="relative w-1/2 mx-auto">
      <img src="/assets/images/hero_logo-w.svg" alt="Nítida Digital" class="w-full relative z-10" />
      <div class="absolute inset-0 bg-gradient-to-t from-black to-transparent z-20 pointer-events-none"></div>
    </div>

    <div class="max-w-screen-lg mx-auto py-4 text-xs text-center text-zinc-500">
      <span>© {new Date().getFullYear()} Nítida. Todos los derechos reservados.</span>
    </div>
  </div>
</footer>
