---
import { site } from '../data/site';

const { hideTerms = false, hideSocial = false } = Astro.props;

const links = [
  { label: 'Inicio', href: '/' },
  { label: 'Sitios web', href: '/web-design' },
  { label: 'Identidad visual', href: '/branding' },
  { label: 'Planes', href: '/planes' },
  { label: 'Contacto', href: '/contact' },
  { label: 'Productos propios', href: '/digital-products' },
  ...(hideTerms ? [] : [{ label: 'Términos y condiciones', href: '/terms-and-conditions' }]),
];

const socialLinks = [
  { label: 'Instagram', href: site.instagram, external: true },
];
---

<footer class="bg-gradient-to-r from-gray-900 via-black to-gray-800 text-white border-t border-gray-800">
  <div class="max-w-screen-lg mx-auto">
    <nav class="border-b border-gray-700 mb-12" aria-label="Pie de página">
      <div class="max-w-screen-xl mx-auto px-4 py-6 flex flex-col md:flex-row justify-between gap-6 text-sm">
        <div class="flex flex-wrap gap-x-6 gap-y-3 items-center">
          {links.map((link) => (
            <a href={link.href} class="hover:text-gray-300 transition-colors">
              {link.label}
            </a>
          ))}
        </div>
        {!hideSocial && (
          <div class="flex gap-6 items-center">
            {socialLinks.map((link) => (
              <a
                href={link.href}
                {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                class="hover:text-gray-300 transition-colors"
              >
                {link.label}
              </a>
            ))}
            <a
              href={site.mailto}
              class="hover:text-gray-300 transition-colors"
              data-track="email_click"
            >
              Correo
            </a>
          </div>
        )}
      </div>
    </nav>

    <div class="relative w-1/2 mx-auto">
      <img src="/assets/images/hero_logo-w.svg" alt="Nítida Digital" class="w-full relative z-10" />
      <div class="absolute inset-0 bg-gradient-to-t from-black to-transparent z-20 pointer-events-none"></div>
    </div>

    <div class="max-w-screen-lg mx-auto py-4 text-xs text-center text-zinc-500">
      <span>© {new Date().getFullYear()} Nítida. Todos los derechos reservados.</span>
    </div>
  </div>
</footer>
