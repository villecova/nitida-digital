---
import { getCollection } from 'astro:content';
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import AboutBrief from '../components/home/AboutBrief.astro';
import FeaturedProjects from '../components/home/FeaturedProjects.astro';
import Process from '../components/home/Process.astro';
import Contact from '../components/Contact.astro';
import Welcome from '../components/Welcome.astro';
import { site } from '../data/site';
import { es } from '../i18n/es';
import { sortProjects } from '../lib/projects';
import Layout from '../layouts/Layout.astro';

const pageTitle = 'Nítida Digital — Sitios web e identidad visual para negocios';
const pageDescription =
  'Diseño y desarrollo web e identidad visual para emprendedores, profesionales y marcas en México y Latinoamérica.';
const pageUrl = `${site.siteUrl}/`;
const imageUrl = `${site.siteUrl}/assets/images/og_image.png`;

const t = es.home;

const allEntries = await getCollection('work');
const featured = allEntries
  .filter((e) => e.data.visible && e.data.featured)
  .sort(sortProjects)
  .slice(0, 5)
  .map((entry) => ({
    slug: entry.slug,
    title: entry.data.title,
    description: entry.data.description,
    image: entry.data.image,
    serviceCategories: entry.data.serviceCategories ?? [],
    scope: entry.data.scope,
    role: entry.data.role,
    url: entry.data.url,
  }));
---

<Layout pageTitle={pageTitle} pageDescription={pageDescription} pageUrl={pageUrl} imageUrl={imageUrl}>
  <Navbar currentPath="/" />

  <Welcome
    type="color"
    color="bg-gradient-to-r from-gray-900 via-black to-gray-800"
    title={t.hero.title}
    subtitle={t.hero.subtitle}
    primaryButton={t.hero.cta}
    secondaryButton={t.hero.ctaSecondary}
    primaryLink="/contact#formulario"
    secondaryLink="#proyectos-destacados"
    mediaVariant="logo"
  />

  <!-- Servicios principales -->
  <section class="py-16 md:py-24 bg-white" id="servicios">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12" data-aos="fade-up" data-aos-delay="100">
        <h2 class="text-3xl md:text-5xl font-main text-gray-900 my-2">{t.services.title}</h2>
        <p class="text-lg text-accent max-w-2xl mx-auto">{t.services.subtitle}</p>
      </div>

      <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        <a
          href="/web-design"
          class="block bg-white rounded-2xl p-8 border border-gray-200 shadow-sm hover:shadow-md transition-shadow duration-300"
          data-aos="fade-up"
          data-aos-delay="150"
        >
          <div class="w-16 h-16 bg-blue-100 rounded-xl flex items-center justify-center mb-6">
            <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-3 leading-tight">Sitios web</h3>
          <p class="text-gray-600 mb-6 text-sm leading-relaxed">
            Landings, sitios para negocios y profesionales, y e-commerce sencillo — claros, rápidos y pensados para generar contacto.
          </p>
          <span class="text-blue-600 font-semibold text-sm inline-flex items-center">
            Ver servicio
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </span>
        </a>

        <a
          href="/branding"
          class="block bg-white rounded-2xl p-8 border border-gray-200 shadow-sm hover:shadow-md transition-shadow duration-300"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          <div class="w-16 h-16 bg-purple-100 rounded-xl flex items-center justify-center mb-6">
            <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zM21 5a2 2 0 00-2-2h-4a2 2 0 00-2 2v12a4 4 0 004 4h4a2 2 0 002-2V5z"></path>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-3 leading-tight">Identidad visual</h3>
          <p class="text-gray-600 mb-6 text-sm leading-relaxed">
            Logotipo, sistema visual y materiales digitales para que tu marca se vea coherente y profesional.
          </p>
          <span class="text-purple-600 font-semibold text-sm inline-flex items-center">
            Ver servicio
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <FeaturedProjects projects={featured} />

  <!-- Beneficios -->
  <section class="py-16 md:py-24 bg-slate-50" id="beneficios">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12" data-aos="fade-up" data-aos-delay="100">
        <h2 class="text-3xl md:text-5xl font-main text-gray-900 my-2">{t.benefits.title}</h2>
        <p class="text-lg text-accent max-w-2xl mx-auto">{t.benefits.subtitle}</p>
      </div>
      <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        {t.benefits.items.map((item, index) => (
          <div
            class="bg-white rounded-2xl p-8 border border-gray-200 shadow-sm"
            data-aos="fade-up"
            data-aos-delay={150 + index * 50}
          >
            <h3 class="text-xl font-bold text-gray-900 mb-3">{item.title}</h3>
            <p class="text-sm text-gray-600 leading-relaxed">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Process />

  <!-- Productos propios (secundario) -->
  <section class="py-16 md:pb-24 bg-slate-50" id="productos">
    <div class="max-w-3xl mx-auto px-4 text-center" data-aos="fade-up" data-aos-delay="100">
      <h2 class="text-3xl md:text-4xl font-main text-gray-900 my-2 mb-4">{t.digitalProducts.title}</h2>
      <p class="text-base text-accent leading-relaxed mb-8">{t.digitalProducts.subtitle}</p>
      <a
        href="/digital-products"
        class="inline-flex items-center text-sm font-semibold text-gray-900 hover:opacity-70"
      >
        Ver productos propios →
      </a>
    </div>
  </section>

  <AboutBrief />

  <Contact />

  <Footer />
</Layout>

<script>
  import { track } from '../lib/analytics';

  document.querySelectorAll('[data-track="project_click"]').forEach((el) => {
    el.addEventListener('click', () => {
      track('project_click', {
        project: el.getAttribute('data-project') || undefined,
        source: 'home',
      });
    });
  });
</script>
