---
import { getCollection } from 'astro:content';
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import ComoTrabajamos from '../components/shared/ComoTrabajamos.astro';
import IdealPara from '../components/shared/IdealPara.astro';
import QueObtienes from '../components/shared/QueObtienes.astro';
import ServiceCTA from '../components/shared/ServiceCTA.astro';
import ServicePortfolio from '../components/shared/ServicePortfolio.astro';
// import WebsiteMaintenance from '../components/shared/WebsiteMaintenance.astro';
import Welcome from '../components/Welcome.astro';
import { site } from '../data/site';
import { es } from '../i18n/es';
import { hasCategory, sortProjects } from '../lib/projects';
import Layout from '../layouts/Layout.astro';

const pageTitle = "Sitios web — Diseño y desarrollo | Nítida Digital";
const pageDescription = "Sitios web claros, responsivos y pensados para convertir visitas en contactos. Diseño y desarrollo para negocios y profesionales.";
const pageUrl = `${site.siteUrl}/web-design`;
const imageUrl = `${site.siteUrl}/assets/images/og_image.png`;

const allEntries = await getCollection('work');
const webProjects = allEntries
  .filter((entry) => entry.data.visible && hasCategory(entry, 'web'))
  .sort(sortProjects);

const projects = webProjects.map((entry) => ({
  slug: entry.slug,
  title: entry.data.title,
  gallery: entry.data.gallery || [],
  year: entry.data.year,
}));

const t = es.webDesign;
---

<Layout pageTitle={pageTitle} pageDescription={pageDescription} pageUrl={pageUrl} imageUrl={imageUrl}>
	<Navbar currentPath="/web-design" />
	
	<Welcome 
		type="color"
		backgroundImage="/assets/images/heroes/web-design.jpg"
		title={t.hero.title}
		subtitle={t.hero.subtitle}
		primaryButton={t.hero.primaryButton}
		primaryLink="/contact#formulario"
		secondaryButton={t.hero.secondaryButton}
		secondaryLink="#portafolio"
		mediaVariant="none"
		colorScheme="blue"
		align="left"
	/>

	<IdealPara 
		title={t.idealFor.title}
		items={t.idealFor.items.map(item => ({ iconPath: item.icon, title: item.title, description: item.description }))}
		colorScheme="blue"
	/>

	<QueObtienes 
		title={t.whatYouGet.title}
		intro={t.whatYouGet.intro}
		examples={t.whatYouGet.examples}
		items={t.whatYouGet.items.map(item => ({ iconPath: item.icon, title: item.title, description: item.description }))}
		colorScheme="blue"
	/>

	<ComoTrabajamos 
		title={t.howWeWork.title}
		steps={t.howWeWork.steps}
		colorScheme="blue"
	/>

	<ServicePortfolio 
		title={t.portfolio.title}
		subtitle={t.portfolio.subtitle}
		emptyMessage={t.portfolio.empty}
		{projects}
		colorScheme="blue"
	/>

	{/* WebsiteMaintenance oculto temporalmente */}

	<ServiceCTA 
		title={t.cta.title}
		description={t.cta.description}
		primaryButtonLabel={t.cta.primaryButton}
		primaryButtonHref="/contact#formulario"
		secondaryButtonLabel="Ver proyectos web"
		secondaryButtonHref="#portafolio"
		colorScheme="blue"
	/>

	<Footer />
</Layout>
