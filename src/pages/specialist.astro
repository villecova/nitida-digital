---
import Welcome from '../components/Welcome.astro';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Gallery from '../components/Gallery.astro';
import Princing from '../components/Princing.astro';
import Footer from '../components/Footer.astro';
import How from '../components/How.astro';
import Contact from '../components/Contact.astro';
import Benefits from '../components/Benefits.astro';
import Individual from '../components/Individual.astro';
import { site } from '../data/site';

const currentPath = Astro.url.pathname;
const pageTitle = 'Plan Especialista | Nítida Digital';
const pageDescription =
  'Identidad visual para especialistas: médicos, terapeutas y profesionistas independientes.';
const pageUrl = `${site.siteUrl}/specialist`;
---

<!--
  Decisión Fase 1: /specialist se conserva como landing del Plan Especialista.
  noindex para no competir con páginas principales. Enlazada desde Planes.
  Ver INTEGRACIONES.md
-->
<Layout
  pageTitle={pageTitle}
  pageDescription={pageDescription}
  pageUrl={pageUrl}
  noindex={true}
>
  <Navbar currentPath={currentPath} />
  <Welcome
    type="color"
    color="bg-primary"
    title="Impulsa tu imagen profesional con diseño estratégico"
    subtitle="Diseño e identidad visual para especialistas que buscan proyectar confianza y claridad."
    primaryButton="Cuéntame sobre tu proyecto"
    primaryLink="/contact#formulario"
    secondaryButton=""
    secondaryLink=""
    mediaVariant="icons"
  />
  <Gallery />
  <How />
  <Benefits onlySpecialist={true} />
  <Princing onlySpecialist={true} />
  <Individual onlySpecialist={true} />
  <Contact />
  <Footer />
</Layout>
