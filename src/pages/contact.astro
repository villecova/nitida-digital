---
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import ContactForm from '../components/shared/ContactForm.svelte';
import { site } from '../data/site';
import Layout from '../layouts/Layout.astro';

const pageTitle = 'Contacto | Nítida Digital';
const pageDescription =
  'Solicita información sobre diseño web o identidad visual. Cuéntame sobre tu proyecto y te oriento sobre el siguiente paso.';
const pageUrl = `${site.siteUrl}/contact`;
const imageUrl = `${site.siteUrl}/assets/images/og_image.png`;
const formAvailable = Boolean(site.formspreeEndpoint);
---

<Layout pageTitle={pageTitle} pageDescription={pageDescription} pageUrl={pageUrl} imageUrl={imageUrl}>
  <Navbar currentPath="/contact" />

  <section class="min-h-[75vh] flex flex-col justify-center pt-24 pb-16 md:pt-28 md:pb-24 bg-white" id="contacto">
    <div class="max-w-6xl mx-auto px-4 w-full">
      <div class="grid lg:grid-cols-5 gap-12">
        <div class="lg:col-span-3" data-aos="fade-up" data-aos-delay="100">
          {formAvailable ? (
            <>
              <h2 class="text-3xl md:text-4xl font-main text-gray-900 mb-3">Formulario de contacto</h2>
              <p class="text-accent mb-8 text-base">
                Completa el formulario con la información de tu proyecto. Con estos datos podré orientarte sobre el siguiente paso.
              </p>
              <ContactForm
                client:load
                formspreeEndpoint={site.formspreeEndpoint}
                emailFallback={site.email}
              />
            </>
          ) : (
            <div id="formulario">
              <h2 class="text-3xl md:text-4xl font-main text-gray-900 mb-3">Contacto</h2>
              <p class="text-accent mb-8 text-base">
                Cuéntame sobre tu proyecto por correo a{' '}
                <a
                  href={site.mailtoWithSubject(
                    'Consulta desde el sitio web',
                    'Buen día, me gustaría obtener más información sobre sus servicios. Quedo atento(a).'
                  )}
                  class="text-primary font-medium hover:opacity-80"
                  data-track="email_click"
                >
                  {site.email}
                </a>. Con esa información podré orientarte sobre el siguiente paso.
              </p>
              <a
                href={site.mailtoWithSubject(
                  'Consulta desde el sitio web',
                  'Buen día, me gustaría obtener más información sobre sus servicios. Quedo atento(a).'
                )}
                class="mx-auto md:mx-0 flex w-fit items-center justify-center px-8 py-3 text-base font-medium rounded-lg bg-gray-900 text-white hover:bg-black focus:outline-none focus:ring-4 focus:ring-gray-900/30 transition-all"
                data-track="email_click"
              >
                Escribir por correo
              </a>
              <p class="mt-4 text-xs text-gray-500">
                Los datos se utilizan únicamente para atender esta consulta.
              </p>
            </div>
          )}
        </div>

        <aside class="lg:col-span-2 space-y-6" data-aos="fade-up" data-aos-delay="150">
          {formAvailable && (
            <div class="bg-slate-50 rounded-2xl p-6 border border-gray-200">
              <h3 class="text-lg font-bold text-gray-900 mb-2">Correo electrónico</h3>
              <p class="text-sm text-gray-600 mb-4">
                Disponible para consultas más detalladas o si prefieres escribir directamente.
              </p>
              <a
                href={site.mailtoWithSubject(
                  'Consulta desde el sitio web',
                  'Buen día, me gustaría obtener más información sobre sus servicios. Quedo atento(a).'
                )}
                class="block w-full bg-gray-900 text-white font-semibold py-3 px-6 rounded-xl text-center hover:bg-black transition-colors text-sm"
                data-track="email_click"
              >
                {site.email}
              </a>
            </div>
          )}

          {site.hasWhatsApp && site.whatsappUrl && (
            <div class="bg-slate-50 rounded-2xl p-6 border border-gray-200">
              <h3 class="text-lg font-bold text-gray-900 mb-2">WhatsApp</h3>
              <p class="text-sm text-gray-600 mb-4">Canal disponible para consultas breves.</p>
              <a
                href={site.whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="block w-full bg-green-600 text-white font-semibold py-3 px-6 rounded-xl text-center hover:bg-green-700 transition-colors text-sm"
                data-track="whatsapp_click"
              >
                Enviar mensaje
              </a>
            </div>
          )}

          <div class="bg-white rounded-2xl p-6 border border-gray-200">
            <h3 class="text-lg font-bold text-gray-900 mb-4">Próximos pasos</h3>
            <ul class="space-y-3 text-sm text-gray-600">
              <li class="flex gap-2">
                <span class="text-gray-900 font-semibold">1.</span>
                Reviso tu mensaje y te respondo.
              </li>
              <li class="flex gap-2">
                <span class="text-gray-900 font-semibold">2.</span>
                Si el proyecto es viable, conversamos para definir objetivos.
              </li>
              <li class="flex gap-2">
                <span class="text-gray-900 font-semibold">3.</span>
                Recibes una propuesta con alcance y cotización.
              </li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<script>
  import { track } from '../lib/analytics';

  document.querySelectorAll('[data-track]').forEach((el) => {
    el.addEventListener('click', () => {
      const event = el.getAttribute('data-track');
      if (event) track(event, { source: 'contact' });
    });
  });
</script>
